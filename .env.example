# ============================================
# EOLIYA Ingénierie - Docker Compose Environment Variables
# ============================================
# Ce fichier configure l'environnement Docker local
# Copier vers .env et ajuster selon vos besoins

# ----------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_PORT=5432

# ----------------------------------------------
# Node Environment
# ----------------------------------------------
NODE_ENV=development

# ----------------------------------------------
# Strapi URLs
# ----------------------------------------------
STRAPI_PUBLIC_URL=http://localhost:1337
STRAPI_ADMIN_URL=http://localhost:1337/admin

# ----------------------------------------------
# Next.js URLs
# ----------------------------------------------
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------
# PgAdmin Configuration (Optionnel)
# ----------------------------------------------
# Pour accéder à PgAdmin: http://localhost:5050
# Démarrer avec: docker-compose --profile tools up -d
PGADMIN_EMAIL=admin@eoliya.com
PGADMIN_PASSWORD=admin

# ----------------------------------------------
# Development Ports
# ----------------------------------------------
# Ne modifier que si vous avez des conflits de ports
# FRONTEND_PORT=3000
# BACKEND_PORT=1337
# POSTGRES_PORT=5432
# PGADMIN_PORT=5050

# ----------------------------------------------
# Optional: API Keys for Development
# ----------------------------------------------
# Ajouter vos clés API pour le développement local
# OPENAI_API_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
