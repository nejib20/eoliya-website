# ============================================
# EOLIYA Ingénierie - Frontend Environment Variables
# ============================================

# ----------------------------------------------
# Strapi Backend Configuration
# ----------------------------------------------
# URL du backend Strapi (API)
# Dev: http://localhost:1337
# Prod: https://api.eoliya.com ou votre URL Railway
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# ----------------------------------------------
# Site Configuration
# ----------------------------------------------
# URL publique du site
# Dev: http://localhost:3000
# Prod: https://eoliya.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------
# Analytics & Tracking
# ----------------------------------------------
# Google Analytics Measurement ID
# Format: G-XXXXXXXXXX
# Laissez vide en développement
NEXT_PUBLIC_GA_ID=

# ----------------------------------------------
# OpenAI Integration (Chatbot IA)
# ----------------------------------------------
# Clé API OpenAI pour le chatbot intelligent
# Obtenir sur: https://platform.openai.com/api-keys
# IMPORTANT: Ne JAMAIS committer cette clé
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------
# Google Calendar API (Prise de rendez-vous)
# ----------------------------------------------
# Configuration OAuth 2.0 pour Google Calendar
# Documentation: https://developers.google.com/calendar/api/quickstart/nodejs
# Obtenir sur: https://console.cloud.google.com/

# Client ID OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Client Secret OAuth
# IMPORTANT: Ne JAMAIS committer ce secret
GOOGLE_CLIENT_SECRET=your_client_secret

# Refresh Token OAuth (obtenir via script /scripts/get-google-refresh-token.js)
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URI de redirection après authentification
# Dev: http://localhost:3000/api/calendar/callback
# Prod: https://eoliya.com/api/calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ID du calendrier à utiliser
GOOGLE_CALENDAR_ID=primary

# ----------------------------------------------
# Resend Email Service (Contact form)
# ----------------------------------------------
# Documentation: https://resend.com/docs
# Pour l'envoi d'emails transactionnels

# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email expéditeur (doit être vérifié dans Resend)
RESEND_FROM_EMAIL=contact@eoliya.com

# Email destinataire pour les formulaires de contact
CONTACT_EMAIL=contact@eoliya.com

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
# Nombre maximum de requêtes autorisées
RATE_LIMIT_MAX=10

# Fenêtre de temps en millisecondes (60000 = 1 minute)
RATE_LIMIT_WINDOW=60000

# ----------------------------------------------
# Security & Performance
# ----------------------------------------------
# Désactiver la télémétrie Next.js (optionnel)
NEXT_TELEMETRY_DISABLED=1

# ----------------------------------------------
# Feature Flags (Optionnel)
# ----------------------------------------------
# Activer/désactiver certaines fonctionnalités
NEXT_PUBLIC_FEATURE_CHATBOT=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_ANALYTICS=false

# ----------------------------------------------
# Development Only
# ----------------------------------------------
# Mode debug
DEBUG=false

# Afficher les logs détaillés
NEXT_PUBLIC_DEBUG_MODE=false
