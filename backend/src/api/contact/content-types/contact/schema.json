{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact",
    "description": "Demandes de contact et RDV"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "prenom": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "telephone": {
      "type": "string"
    },
    "entreprise": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "rdv_date": {
      "type": "datetime"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "en-cours",
        "traite",
        "archive"
      ],
      "default": "nouveau"
    },
    "typeDeContact": {
      "type": "enumeration",
      "enum": [
        "information",
        "devis",
        "partenariat",
        "recrutement",
        "autre"
      ]
    },
    "notes": {
      "type": "text"
    }
  }
}
