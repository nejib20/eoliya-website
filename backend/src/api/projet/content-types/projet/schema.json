{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Projet",
    "description": "Projets et références clients"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "client": {
      "type": "string",
      "required": true
    },
    "categorie": {
      "type": "enumeration",
      "enum": [
        "energie-renouvelable",
        "efficacite-energetique",
        "ingenierie-industrielle",
        "etude-technique",
        "environnement"
      ],
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "contenu": {
      "type": "richtext"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "localisation": {
      "type": "string"
    },
    "duree": {
      "type": "string"
    },
    "budget": {
      "type": "string"
    },
    "tags": {
      "type": "json"
    }
  }
}
