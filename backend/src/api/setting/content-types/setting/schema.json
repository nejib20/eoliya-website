{
  "kind": "singleType",
  "collectionName": "setting",
  "info": {
    "singularName": "setting",
    "pluralName": "settings",
    "displayName": "Settings",
    "description": "Configuration globale du site"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "EOLIYA Ingénierie"
    },
    "siteDescription": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "socialLinks": {
      "type": "json"
    },
    "contact": {
      "type": "json"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.metadata"
    },
    "maintenance": {
      "type": "boolean",
      "default": false
    },
    "analytics": {
      "type": "json"
    }
  }
}
