{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Articles de blog et actualités"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "contenu": {
      "type": "richtext",
      "required": true
    },
    "auteur": {
      "type": "string",
      "required": true
    },
    "categorie": {
      "type": "enumeration",
      "enum": [
        "actualites",
        "etudes-de-cas",
        "guides-techniques",
        "innovation",
        "reglementation"
      ],
      "required": true
    },
    "tags": {
      "type": "json"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "publishedAt": {
      "type": "datetime"
    },
    "extrait": {
      "type": "text"
    },
    "tempsLecture": {
      "type": "integer"
    }
  }
}
